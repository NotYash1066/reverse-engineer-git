# Optional. Used server-side to increase GitHub API rate limits for public repository analysis.
GITHUB_TOKEN=

# Required. The analysis pipeline now depends on a configured LLM provider.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Optional. For providers that require or support a custom base URL, such as OpenRouter,
# GitHub Models gateways, NVIDIA-hosted endpoints, or other OpenAI-compatible services.
LLM_BASE_URL=
